    "question": "Benarkah proyek gas LNG di Teluk Bintuni hanya membawa keuntungan bagi seluruh warga tanpa menimbulkan kerugian?",
    "rounds": [
      {
        "id": 328,
        "round": 1,
        "route": "environment",
        "group": "ngo",
        "kind": "klaim_statemen",
        "question": "Benarkah proyek gas LNG di Teluk Bintuni hanya membawa keuntungan bagi seluruh warga tanpa menimbulkan kerugian?",
